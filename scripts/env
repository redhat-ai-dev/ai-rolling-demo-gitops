# KServe Connector secrets (for make install and make install-kserve-catalog-bridge-rhoai-handled-separately)
# All values below are auto-resolved at install time if left empty.
# K8S_CLUSTER_URL: the API URL of the cluster where RHOAI/KServe is running.
# Defaults to https://kubernetes.default.svc (in-cluster API).
export K8S_CLUSTER_URL=
# K8S_SA_TOKEN: service account token with access to KServe InferenceServices.
# Auto-resolved from the rhdh-rhoai-bridge-token secret.
export K8S_SA_TOKEN=
# K8S_CA_DATA: base64-encoded CA certificate for the cluster API.
# Auto-resolved from the rhdh-rhoai-bridge-token secret.
export K8S_CA_DATA=
# KUBEFLOW_MODEL_CATALOG_URL: the URL of the Kubeflow Model Registry REST API.
# Auto-resolved from the rhoai-model-registries namespace route or service.
export KUBEFLOW_MODEL_CATALOG_URL=

# Boost / OGX secrets (for AI Catalog agent chat)
# Dev cluster default: https://llamastack-llamastack.apps.rosa.redhat-ai-dev.m6no.p3.openshiftapps.com
export BOOST_OGX_URL=https://llamastack-llamastack.apps.rosa.redhat-ai-dev.m6no.p3.openshiftapps.com
export BOOST_MODEL=openai/vllm-inference/gpt-4.1

# GPU Setup (NFD + NVIDIA GPU Operator)
# Set to "true" to skip Node Feature Discovery and NVIDIA GPU operator installation
# while still allowing RHOAI setup. RHOAI can run without GPU for non-inference workloads.
