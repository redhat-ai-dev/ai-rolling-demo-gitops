# Copy to tests/.env and fill in values for local Playwright runs.
# CI sets these via workflow env / secrets instead.

RHDH_BASE_URL=https://rhdh-ci.apps.testing
RHDH_ENVIRONMENT=production
ROLLING_DEMO_TEST_USERNAME=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Optional
# RHDH_DISPLAY_NAME=
# PLAYWRIGHT_HEADLESS=true
